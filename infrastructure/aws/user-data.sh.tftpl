#!/bin/bash
set -euo pipefail
umask 022
exec > >(tee -a /var/log/agent-lab-bootstrap.log) 2>&1
echo 'Installing single-EC2 demo (source ${source_commit})'
dnf install -y python3 unzip iptables tar
command -v aws
id agentlab >/dev/null 2>&1 || useradd --create-home --shell /bin/bash agentlab
install -d -m 755 /opt/agent-security-demo /etc/agent-lab
install -d -m 700 /var/lib/agent-lab-private
install -d -o agentlab -g agentlab -m 700 /var/lib/agent-lab-data
curl --fail --silent --show-error --location --retry 5 'https://codeload.github.com/${source_repository}/zip/${source_commit}' -o /opt/runtime.zip
install -d /opt/demo-source
unzip -q -o /opt/runtime.zip -d /opt/demo-source
cp -a /opt/demo-source/agent-security-demo-${source_commit}/. /opt/agent-security-demo/
rm -rf /opt/demo-source /opt/runtime.zip
chown -R root:root /opt/agent-security-demo
chmod -R a-w /opt/agent-security-demo
echo '${config_b64}' | base64 -d > /etc/agent-lab/config.template.json
chmod 644 /etc/agent-lab/config.template.json

# Ordinary host protection: the model UID cannot access instance-role credentials.
cat > /usr/local/sbin/agent-lab-metadata-block <<'BLOCK'
#!/bin/bash
set -euo pipefail
uid=$(id -u agentlab)
iptables -C OUTPUT -d 169.254.169.254/32 -m owner --uid-owner "$uid" -j REJECT 2>/dev/null || iptables -I OUTPUT 1 -d 169.254.169.254/32 -m owner --uid-owner "$uid" -j REJECT
BLOCK
chmod 755 /usr/local/sbin/agent-lab-metadata-block
cat > /etc/systemd/system/agent-lab-metadata.service <<'UNIT'
[Unit]
Description=Block agent UID from EC2 instance metadata
Before=agent-lab-dashboard.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agent-lab-metadata-block
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now agent-lab-metadata.service

# Install a pinned official CLI as its unprivileged owner; never execute downloaded code as root.
curl --fail --silent --show-error --location https://claude.ai/install.sh -o /home/agentlab/claude-install.sh
chown agentlab:agentlab /home/agentlab/claude-install.sh
runuser -u agentlab -- env HOME=/home/agentlab bash /home/agentlab/claude-install.sh 2.1.318
rm /home/agentlab/claude-install.sh
runuser -u agentlab -- /home/agentlab/.local/bin/claude --version

cat > /usr/local/bin/agent-lab-issue <<'WRAPPER'
#!/bin/bash
set -euo pipefail
[[ $# == 1 && "$1" =~ ^[A-Za-z0-9+/]+={0,2}$ && $${#1} -le 32000 ]] || exit 2
systemctl is-active --quiet agent-lab-metadata.service
iptables -C OUTPUT -d 169.254.169.254/32 -m owner --uid-owner "$(id -u agentlab)" -j REJECT
cd /opt/agent-security-demo
export PYTHONPATH=/opt/agent-security-demo
exec python3 -m scripts.aws_instance_job "$1"
WRAPPER
chmod 755 /usr/local/bin/agent-lab-issue

# Free public DNS names point at this boot's automatically assigned public IPv4.
# No Elastic IP is retained or billed while the instance is stopped.
curl --fail --silent --show-error --location --retry 5 https://github.com/caddyserver/caddy/releases/download/v2.11.9/caddy_2.11.9_linux_amd64.tar.gz -o /opt/caddy.tar.gz
echo '5b8cb7faf8726a2028ad96a66e54e6e81e8f361bc6175e5d22bbd997cc5177fb  /opt/caddy.tar.gz' | sha256sum -c -
tar -xzf /opt/caddy.tar.gz -C /usr/local/bin caddy
rm /opt/caddy.tar.gz
id caddy >/dev/null 2>&1 || useradd --system --home-dir /var/lib/caddy --shell /sbin/nologin caddy
install -d -o caddy -g caddy -m 700 /var/lib/caddy
install -d -m 755 /etc/caddy
cat > /usr/local/sbin/agent-lab-configure <<'CONFIGURE'
#!/bin/bash
set -euo pipefail
token=$(curl -fsS --retry 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)
export EC2_LAB_IP=$(curl -fsS --retry 5 -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/public-ipv4)
python3 - <<'PYCONFIG'
import ipaddress,json,os
from pathlib import Path
ip=str(ipaddress.IPv4Address(os.environ['EC2_LAB_IP'])).replace('.','-')
cfg=json.loads(Path('/etc/agent-lab/config.template.json').read_text())
for name in ('diagnostic_origin','receiver_origin'): cfg[name]=cfg[name].replace('__PUBLIC_IP__',ip)
Path('/etc/agent-lab/config.json').write_text(json.dumps(cfg))
lines=['{','  admin off','  servers {','    protocols h1 h2','  }','}']
for name,port in [('diagnostic_origin',8081),('receiver_origin',8082)]:
    lines += [cfg[name][8:]+' {','  reverse_proxy 127.0.0.1:'+str(port)+' {','    header_up X-Lab-Peer {remote_host}','  }','}']
Path('/etc/caddy/Caddyfile').write_text('\n'.join(lines)+'\n')
PYCONFIG
chmod 644 /etc/agent-lab/config.json /etc/caddy/Caddyfile
CONFIGURE
chmod 755 /usr/local/sbin/agent-lab-configure
cat > /etc/systemd/system/agent-lab-configure.service <<'UNIT'
[Unit]
Description=Set public demo URLs for this boot
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agent-lab-configure
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
UNIT
for role in diagnostic receiver; do
  port=8081
  [ "$role" = receiver ] && port=8082
  cat > "/etc/systemd/system/agent-lab-$role.service" <<UNIT
[Unit]
Description=Synthetic $role endpoint on localhost
Requires=agent-lab-configure.service agent-lab-metadata.service
After=agent-lab-configure.service agent-lab-metadata.service
[Service]
User=agentlab
WorkingDirectory=/opt/agent-security-demo
Environment=PYTHONPATH=/opt/agent-security-demo
ExecStart=/usr/bin/python3 -m endpoints.server --config /etc/agent-lab/config.json --role $role --port $port
Restart=on-failure
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
UNIT
done
cat > /etc/systemd/system/caddy.service <<'UNIT'
[Unit]
Description=HTTPS for the two synthetic demo names
Requires=agent-lab-configure.service
After=network-online.target agent-lab-configure.service
[Service]
User=caddy
Environment=HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/tmpfiles.d/agent-lab.conf <<'CLEAN'
d /var/lib/agent-lab-data/runs 0700 agentlab agentlab ${retention_days}d
CLEAN
systemd-tmpfiles --create /etc/tmpfiles.d/agent-lab.conf

cat > /etc/systemd/system/agent-lab-dashboard.service <<'UNIT'
[Unit]
Description=Read-only local evidence dashboard (SSM tunnel only)
Requires=agent-lab-metadata.service agent-lab-configure.service
After=network-online.target agent-lab-metadata.service agent-lab-configure.service
[Service]
User=agentlab
WorkingDirectory=/opt/agent-security-demo
Environment=PYTHONPATH=/opt/agent-security-demo
ExecStart=/usr/bin/python3 -m dashboard.server --config /etc/agent-lab/config.json
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/systemd/system/agent-lab-stop.service <<'UNIT'
[Unit]
Description=Stop demo instance to limit idle compute cost
[Service]
Type=oneshot
ExecStart=/usr/sbin/shutdown -h now
UNIT
cat > /etc/systemd/system/agent-lab-stop.timer <<'UNIT'
[Unit]
Description=Stop demo instance ${auto_stop_hours} hours after each boot
[Timer]
OnBootSec=${auto_stop_hours}h
Unit=agent-lab-stop.service
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now agent-lab-configure.service agent-lab-diagnostic.service agent-lab-receiver.service caddy.service agent-lab-dashboard.service agent-lab-stop.timer
touch /var/lib/agent-lab-private/bootstrap-complete
echo 'Agent lab bootstrap complete; add the API key using the operator helper before opening issues.'
